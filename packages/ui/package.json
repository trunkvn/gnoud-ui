{
  "name": "@gnoud-ui/react",
  "version": "0.4.0",
  "description": "Accessible React components with a paper-and-ink design language. Hard shadows, ruled borders, light and dark themes, plain CSS.",
  "keywords": [
    "react",
    "components",
    "ui",
    "design-system",
    "accessible",
    "a11y",
    "base-ui",
    "css",
    "dark-mode",
    "tailwind"
  ],
  "homepage": "https://gnoud-ui.vercel.app",
  "bugs": {
    "url": "https://github.com/trunkvn/gnoud-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/trunkvn/gnoud-ui.git",
    "directory": "packages/ui"
  },
  "license": "MIT",
  "author": "gnoud",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": {
      "types": "./dist/styles.d.ts",
      "default": "./dist/styles.css"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@tsdown/css": "^0.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.2",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.23.1",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
